<div class="auth-page">
  <%= link_to root_path, class: "auth-logo" do %>
    <i class="fa-solid fa-book-open-reader"></i>
    <span>Reflekto</span>
  <% end %>

  <div class="auth-card" style="text-align: center;">
    <div style="font-size: 2.5rem; margin-bottom: 16px;">📬</div>
    <h2 class="auth-card__title">Check your inbox</h2>
    <p class="auth-card__subtitle">
      We sent a confirmation link to your email address.<br>
      Click it to activate your account and start journaling.
    </p>
    <p style="font-size: 0.82rem; color: rgba(255,255,255,0.35); margin-top: 8px; margin-bottom: 24px;">
      The link expires in 24 hours. If you don't see it, check your <strong style="color: rgba(255,255,255,0.5);">spam or junk folder</strong>.
    </p>
    <div class="auth-links">
      <div class="auth-link-row">
        Didn't get it? <%= link_to "Resend confirmation", new_user_confirmation_path %>
      </div>
      <div class="auth-link-row">
        <%= link_to "Back to sign in", new_user_session_path %>
      </div>
    </div>
  </div>
</div>
