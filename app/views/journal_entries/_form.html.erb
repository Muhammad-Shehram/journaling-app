<% cancel_path = @journal_entry.new_record? ?
     journal_journal_entries_path(@journal) :
     journal_journal_entry_path(@journal, @journal_entry) %>

<% date_value = @journal_entry.entry_date.present? ?
     @journal_entry.entry_date.strftime("%Y-%m-%d") :
     Date.today.strftime("%Y-%m-%d") %>

<div class="canvas" data-controller="font-picker" data-font-picker-font-value="<%= @journal_entry.font.presence || 'default' %>">
  <%= simple_form_for([@journal, @journal_entry], html: { class: "canvas__form", multipart: true }) do |f| %>

    <div class="canvas__bar">
      <%= link_to cancel_path, class: "canvas__cancel" do %>
        <i class="fa-solid fa-arrow-left"></i> Cancel
      <% end %>
      <button type="submit" class="canvas__save">
        <%= @journal_entry.new_record? ? "Save Entry" : "Update Entry" %>
      </button>
    </div>

    <div class="canvas__body">

      <%# Context strip: journal name on the left, date chip on the right %>
      <div class="canvas__context">
        <% if @journal_entry.new_record? %>
          <%# Interactive picker on the new-entry form %>
          <div class="journal-switcher"
               data-controller="journal-picker"
               data-journal-picker-journals-value="<%= @sidebar_journals.map { |j|
                 { id: j.id, name: j.name, color: (j.color || '#3ABF6A'), path: journal_journal_entries_path(j) }
               }.to_json %>"
               data-journal-picker-new-journal-url-value="<%= new_journal_path %>"
               data-journal-picker-current-id-value="<%= @journal.id %>">
            <button type="button"
                    class="journal-pill journal-pill--picker"
                    style="--journal-pill-color: <%= @journal.color || '#3ABF6A' %>"
                    data-journal-picker-target="trigger"
                    data-action="click->journal-picker#toggle">
              <span data-journal-picker-target="pillLabel"><%= @journal.name %></span>
              <i class="fa-solid fa-chevron-down journal-pill__chevron"></i>
            </button>
            <div class="journal-picker-dropdown" data-journal-picker-target="dropdown"></div>
          </div>
        <% else %>
          <%# Static pill on the edit form %>
          <span class="journal-pill" style="--journal-pill-color: <%= @journal.color || '#3ABF6A' %>">
            <%= @journal.name %>
          </span>
        <% end %>
        <%= f.text_field :entry_date,
                        type: "date",
                        class: "canvas__date-chip",
                        "aria-label": "Entry date",
                        value: date_value %>
      </div>

      <%# Cover photo preview — below context strip, above title %>
      <% if @journal_entry.cover_photo.attached? %>
        <div class="canvas__cover-preview">
          <%= image_tag @journal_entry.cover_photo, class: "canvas__cover-img canvas__cover-preview-img", alt: "Cover photo" %>
          <button type="button" class="canvas__cover-remove" data-action="click->font-picker#removePhoto">
            <i class="fa-solid fa-xmark"></i> Remove photo
          </button>
        </div>
      <% else %>
        <div class="canvas__cover-preview" style="display:none">
          <img class="canvas__cover-img canvas__cover-preview-img" src="" alt="Cover photo preview">
          <button type="button" class="canvas__cover-remove" data-action="click->font-picker#removePhoto">
            <i class="fa-solid fa-xmark"></i> Remove photo
          </button>
        </div>
      <% end %>

      <%# Title — textarea so long prompts wrap instead of scrolling horizontally %>
      <%= f.input :title,
                  label: false,
                  as: :text,
                  placeholder: "Title",
                  input_html: {
                    class: "canvas__title-input",
                    autofocus: @journal_entry.new_record?,
                    "aria-label": "Entry title",
                    rows: 1,
                    data: {
                      action: "keydown->font-picker#titleKeydown input->font-picker#autoResizeTitle",
                      "font-picker-target": "titleInput"
                    }
                  } %>

      <div class="canvas__divider"></div>

      <%# Rich text content area %>
      <div class="canvas__rich-editor">
        <%= f.rich_text_area :content,
                             placeholder: "Start writing…",
                             class: "canvas__content-input",
                             "aria-label": "Entry content" %>
      </div>

      <%# Tag footer — hidden by default, toggled via toolbar tag icon %>
      <div class="canvas__tag-footer"
           data-font-picker-target="tagFooter"
           data-controller="tag-input"
           data-tag-input-existing-value="<%= @journal_entry.tags.map(&:name).join(', ') %>"
           data-tag-input-suggestions-value="<%= @user_tags.map(&:name).to_json %>">
        <div class="tag-quick-row" data-tag-input-target="quickRow" style="display:none"></div>
        <div class="tag-input-wrap">
          <i class="fa-solid fa-tag tag-input-icon"></i>
          <div class="tag-input-chips" data-tag-input-target="chips"></div>
          <input type="text"
                 class="tag-input-field"
                 placeholder="Add tags…"
                 autocomplete="off"
                 data-tag-input-target="input"
                 data-action="keydown->tag-input#onKeydown input->tag-input#showSuggestions blur->tag-input#hideSuggestions">
          <div class="tag-suggestions" data-tag-input-target="suggestions" style="display:none"></div>
        </div>
        <%= hidden_field_tag "journal_entry[tag_list]",
            @journal_entry.tags.map(&:name).join(', '),
            data: { "tag-input-target": "field" } %>
      </div>

      <%# Hidden cover photo file input — triggered by bottom bar photo button %>
      <%= f.file_field :cover_photo,
          id: "cover-photo-input",
          class: "canvas__photo-file-input",
          accept: "image/*",
          data: { action: "change->font-picker#previewPhoto" } %>
      <input type="hidden" name="journal_entry[remove_cover_photo]" value="0" id="remove-cover-photo-flag">
      <input type="hidden" name="journal_entry[font]" value="<%= @journal_entry.font.presence || 'default' %>" id="entry-font-field">

    </div>

  <% end %>

  <%# Bottom toolbar: Photo · Tag · Aa %>
  <div class="canvas__bottom-bar">
    <label for="cover-photo-input" class="canvas__bar-icon-btn" title="Add cover photo" role="button" tabindex="0">
      <i class="fa-regular fa-image"></i>
    </label>
    <button type="button" class="canvas__bar-icon-btn" title="Add tags"
            data-action="click->font-picker#toggleTags">
      <i class="fa-solid fa-tag"></i>
    </button>
    <button class="canvas__bar-icon-btn canvas__bar-icon-btn--aa"
            type="button"
            aria-label="Change font and formatting"
            data-font-picker-target="trigger"
            data-action="click->font-picker#toggle">
      Aa
    </button>
  </div>

  <div class="canvas__font-popup" data-font-picker-target="popup" role="dialog" aria-label="Formatting options">

    <%# — Fonts — %>
    <div class="canvas__fp-section-label">Fonts</div>
    <% [
      { key: "default", label: "Default",    preview: "The quick brown fox" },
      { key: "serif",   label: "Serif",      preview: "The quick brown fox" },
      { key: "sans",    label: "Sans-serif", preview: "The quick brown fox" },
      { key: "mono",    label: "Monospace",  preview: "const hello = 'world'" }
    ].each do |font| %>
      <button class="canvas__font-option"
              type="button"
              data-font="<%= font[:key] %>"
              data-font-picker-target="option"
              data-action="click->font-picker#select">
        <span class="canvas__font-name"><%= font[:label] %></span>
        <span class="canvas__font-preview canvas__font-preview--<%= font[:key] %>"><%= font[:preview] %></span>
      </button>
    <% end %>

    <div class="canvas__fp-divider"></div>

    <%# — Text Style — %>
    <div class="canvas__fp-section-label">Text Style</div>
    <div class="canvas__fp-grid">
      <button class="canvas__fp-format-btn" type="button"
              title="Bold" data-attr="bold"
              data-action="mousedown->font-picker#format">
        <strong>B</strong>
      </button>
      <button class="canvas__fp-format-btn" type="button"
              title="Italic" data-attr="italic"
              data-action="mousedown->font-picker#format">
        <em>I</em>
      </button>
      <button class="canvas__fp-format-btn canvas__fp-format-btn--strike" type="button"
              title="Strikethrough" data-attr="strike"
              data-action="mousedown->font-picker#format">
        S
      </button>
    </div>

    <div class="canvas__fp-divider"></div>

    <%# — Block Format — %>
    <div class="canvas__fp-section-label">Block Format</div>
    <% [
      { attr: "heading1", label: "Heading",    icon: "fa-heading"    },
      { attr: "quote",    label: "Quote",      icon: "fa-quote-left" },
      { attr: "code",     label: "Code Block", icon: "fa-code"       }
    ].each do |item| %>
      <button class="canvas__fp-row" type="button"
              data-attr="<%= item[:attr] %>"
              data-action="mousedown->font-picker#format">
        <i class="fa-solid <%= item[:icon] %> canvas__fp-row-icon"></i>
        <span><%= item[:label] %></span>
      </button>
    <% end %>

    <div class="canvas__fp-divider"></div>

    <%# — Lists — %>
    <div class="canvas__fp-section-label">Lists</div>
    <% [
      { attr: "bullet", label: "Bullet List",   icon: "fa-list-ul" },
      { attr: "number", label: "Numbered List", icon: "fa-list-ol" }
    ].each do |item| %>
      <button class="canvas__fp-row" type="button"
              data-attr="<%= item[:attr] %>"
              data-action="mousedown->font-picker#format">
        <i class="fa-solid <%= item[:icon] %> canvas__fp-row-icon"></i>
        <span><%= item[:label] %></span>
      </button>
    <% end %>

  </div>

</div>
