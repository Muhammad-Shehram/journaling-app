<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0f0f1a; color: #e8e8f0; margin: 0; padding: 0; }
      .wrapper { max-width: 520px; margin: 40px auto; padding: 0 20px; }
      .card { background: #1a1a2e; border-radius: 12px; padding: 36px 32px; border: 1px solid #2a2a4a; }
      .brand { font-size: 22px; font-weight: 700; color: #1EDD88; margin-bottom: 24px; }
      .icon-circle { width: 48px; height: 48px; border-radius: 50%; background: rgba(30,221,136,0.12); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
      h1 { font-size: 20px; font-weight: 600; color: #e8e8f0; margin: 0 0 12px; }
      p { font-size: 15px; line-height: 1.6; color: #9090b0; margin: 0 0 20px; }
      .cta { display: inline-block; background: #1EDD88; color: #0f1a0f; text-decoration: none; font-weight: 700; font-size: 15px; padding: 12px 28px; border-radius: 8px; }
      .divider { border: none; border-top: 1px solid #2a2a4a; margin: 24px 0; }
      .note { font-size: 13px; color: #555570; margin-top: 20px; }
      .url-fallback { font-size: 12px; color: #555570; word-break: break-all; margin-top: 16px; }
      .footer { margin-top: 28px; font-size: 12px; color: #555570; text-align: center; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="brand">Reflekto</div>
        <h1>Reset your password</h1>
        <p>Hi<%= @resource.name.present? ? " #{@resource.name}" : "" %>, we received a request to reset the password for your Reflekto account (<%= @resource.email %>).</p>
        <p>Click the button below to choose a new password. This link expires in <strong style="color:#e8e8f0;">2 hours</strong>.</p>
        <%= link_to "Reset my password →", edit_password_url(@resource, reset_password_token: @token), class: "cta" %>
        <hr class="divider">
        <p class="note">If you didn't request a password reset, you can safely ignore this email — your password will not change.</p>
        <p class="url-fallback">Or copy this link into your browser:<br><%= edit_password_url(@resource, reset_password_token: @token) %></p>
      </div>
      <div class="footer">
        Reflekto &middot; <a href="https://reflektoapp.com" style="color:#1EDD88;text-decoration:none;">reflektoapp.com</a>
      </div>
    </div>
  </body>
</html>
