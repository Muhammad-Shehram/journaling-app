<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f4f4f7; color: #1a1a2e; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
      .wrapper { max-width: 520px; margin: 40px auto; padding: 0 20px; }
      .card { background: #ffffff; border-radius: 12px; padding: 36px 32px; border: 1px solid #e4e4e8; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
      .brand { font-size: 22px; font-weight: 700; color: #1EDD88; margin-bottom: 24px; }
      h1 { font-size: 20px; font-weight: 600; color: #1a1a2e; margin: 0 0 12px; }
      p { font-size: 15px; line-height: 1.6; color: #555570; margin: 0 0 20px; }
      .footer { margin-top: 28px; font-size: 12px; color: #9090b0; text-align: center; }

      @media (prefers-color-scheme: dark) {
        body { background: #0f0f1a !important; color: #e8e8f0 !important; }
        .card { background: #1a1a2e !important; border-color: #2a2a4a !important; box-shadow: none !important; }
        h1 { color: #e8e8f0 !important; }
        p { color: #9090b0 !important; }
        .footer { color: #555570 !important; }
        .footer a { color: #1EDD88 !important; }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <div class="brand">Reflekto</div>
        <h1>Your email address was updated</h1>
        <% if @resource.try(:unconfirmed_email?) %>
          <p>Hi <%= @email %>, your Reflekto account email is being changed to <strong><%= @resource.unconfirmed_email %></strong>. You'll receive a confirmation email at that address shortly.</p>
        <% else %>
          <p>Hi <%= @email %>, your Reflekto account email has been successfully changed to <strong><%= @resource.email %></strong>.</p>
        <% end %>
        <p>If you didn't make this change, please contact us immediately by replying to this email.</p>
      </div>
      <div class="footer">
        Reflekto &middot; <a href="https://reflektoapp.com" style="color:#1EDD88;text-decoration:none;">reflektoapp.com</a>
      </div>
    </div>
  </body>
</html>
